<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountingEngine.Desktop.Accounting.ViewModels"
             x:Class="AccountingEngine.Desktop.Accounting.Views.PanelView"
             x:DataType="vm:PanelViewModel">

    <StackPanel Spacing="20" Margin="28">
        <StackPanel Spacing="4">
            <TextBlock Text="General › Panel" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource FaintBrush}" />
            <TextBlock Text="Panel financiero" FontFamily="{DynamicResource FontHead}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Resumen de ingresos, gastos y pólizas recientes" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Pantalla pendiente de diseño" FontFamily="{DynamicResource FontHead}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Contenido previsto para el panel financiero:" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                <ItemsControl ItemsSource="{Binding Plan}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="13" Margin="0,2" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
