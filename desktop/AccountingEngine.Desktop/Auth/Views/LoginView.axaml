<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountingEngine.Desktop.Auth.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="AccountingEngine.Desktop.Auth.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="{DynamicResource BgBrush}">
        <Border Classes="card" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Text="AccountingEngine" FontFamily="{DynamicResource FontHead}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="Iniciar sesión" FontFamily="{DynamicResource FontHead}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="Accede a tu empresa en AccountingEngine." FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <Border Classes="alert success" IsVisible="{Binding SuccessMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <Border Classes="alert error" IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="Correo" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                    <TextBox Text="{Binding Email}" PlaceholderText="tu@empresa.com" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Contraseña" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                    <TextBox Text="{Binding Password}" PasswordChar="•" />
                </StackPanel>

                <Button Classes="primary" Content="Iniciar sesión" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="¿No tienes cuenta?" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                    <Button Classes="link" Content="Regístrate" Command="{Binding GoToRegisterCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
